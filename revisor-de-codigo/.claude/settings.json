{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(iconv:*)",
      "Bash(python3 .claude/skills/migracao-massa-teste/scripts/massa.py:*)",
      "Bash(python3 .claude/scripts/garantir_iso8859.py:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(mvn -q compile:*)",
      "Bash(mvn test-compile:*)"
    ],
    "ask": [
      "Bash(mvn clean:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/garantir_iso8859.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
